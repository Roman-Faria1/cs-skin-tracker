# App
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase/Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cs_skin_tracker
# Optional, dedicated integration database (must end in _test). Never use app data here.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cs_skin_tracker_test

# Redis/BullMQ
REDIS_URL=redis://localhost:6379
# Opt-in background collection. Use the same secret on API and worker.
SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=24
SYNC_REQUEST_TIMEOUT_MS=180000
INTERNAL_SYNC_TOKEN=

# CS2Cap
CS2CAP_API_KEY=replace_me
CS2CAP_BASE_URL=https://api.cs2c.app
CS2CAP_MONTHLY_REQUEST_LIMIT=1000
CS2CAP_REQUEST_TIMEOUT_MS=10000
CS2CAP_REFRESH_COOLDOWN_SECONDS=3600
CS2CAP_DEFAULT_PROVIDERS=steam,csfloat,skinport,csmoney_m,csmoney_t
